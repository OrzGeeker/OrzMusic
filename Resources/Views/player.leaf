<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b0d0c">
    <title>OrzMusic · 芯片音乐播放器</title>
    <link rel="icon" href="/brand/favicon.ico?v=20260727-rounded-v5" sizes="any">
    <link rel="icon" href="/brand/orz-logo.svg?v=20260727-rounded-v5" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/brand/orz-logo-192.png?v=20260727-rounded-v5">
    <style>[x-cloak]{display:none!important}</style>
    <link rel="stylesheet" href="/audio/app.css?v=20260927-touch-input-font-v1">
    <script>window.ORZ_PLAYBACK_DIAGNOSTICS_ENABLED = #(playbackDiagnosticsEnabled);</script>
    <script defer src="/audio/player.js?v=20260927-wake-lock-media-session-v1"></script>
    <script defer src="/audio/decoder-manifest.generated.js?v=20260718-sdk-v1"></script>
    <script defer src="/audio/visualizer.js?v=20260723b"></script>
    <script defer src="/audio/app.js?v=20260927-media-session-actions-v1"></script>
    <script defer src="/vendor/alpinejs/alpine-3.15.12.min.js"></script>
</head>
<body x-data="playerApp()" @keydown.window="handleShortcut($event)"
      :class="{'drawer-open': sidebarOpen,'visualizer-visible':currentSong && visualizerOpen}">
    <div class="app-shell">
        <aside class="sidebar" :class="{'open': sidebarOpen}" aria-label="音频格式分类">
            <div class="brand-row">
                <button class="brand-home" title="OrzMusic 首页" aria-label="OrzMusic 首页" @click="selectFormat('')">
                    <span class="brand-mark"><img src="/brand/orz-logo.svg" alt=""></span>
                    <span class="brand-title"><strong>Orz<span>Music</span></strong><small>CHIP AUDIO</small></span>
                </button>
                <button class="icon-btn mobile-only" @click="sidebarOpen=false" aria-label="关闭格式分类">✕</button>
            </div>
            <button class="shortcut-hint" @click="shortcutOpen=true" title="快捷键帮助 (? 或 H)" aria-label="显示快捷键帮助" aria-keyshortcuts="? H"><kbd>?</kbd><span>快捷键</span></button>
            <nav class="format-nav">
                <button class="format-link all" :class="{'active': !formatFilter}" @click="selectFormat('')">
                    <span class="format-dot"></span><span>全部曲目</span><strong x-text="libraryTotal"></strong>
                </button>
                <template x-for="group in formatGroups" :key="group.id">
                    <section class="format-group" x-show="group.items.length">
                        <h2 x-text="group.label"></h2>
                        <template x-for="item in group.items" :key="item.id">
                            <button class="format-link" :class="{'active': formatFilter===item.id}" @click="selectFormat(item.id)">
                                <span class="format-dot" :style="`--dot:${item.color}`"></span>
                                <span x-text="item.label"></span><strong x-text="item.count"></strong>
                            </button>
                        </template>
                    </section>
                </template>
            </nav>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <button class="icon-btn mobile-only" @click="sidebarOpen=true" aria-label="打开格式分类">☰</button>
                <div class="view-heading">
                    <p>音乐资料库</p>
                    <h1 x-text="activeFormatLabel"></h1>
                </div>
                <label class="search-box">
                    <span aria-hidden="true">⌕</span>
                    <input id="songSearch" type="search" placeholder="搜索曲目或艺术家" aria-label="搜索曲目或艺术家"
                           x-model="searchQuery" @input.debounce.250ms="search" @keydown.escape.stop="clearSearch">
                    <kbd>⌘K</kbd>
                </label>
                <button class="import-trigger" x-cloak x-show="adminEnabled" @click="openImportPanel" :aria-expanded="importOpen" aria-controls="directory-import-panel" aria-keyshortcuts="I" title="导入本地目录 (I)">
                    <span aria-hidden="true">↑</span><span>导入</span>
                </button>
                <button class="queue-trigger" @click="playlistOpen ? playlistOpen=false : openPlaylistPanel()" aria-keyshortcuts="Q" :aria-expanded="playlistOpen" title="播放队列 (Q)">
                    <span>队列</span><strong x-text="queue.length"></strong>
                </button>
            </header>

            <section class="library" aria-live="polite">
                <div class="library-summary">
                    <span x-text="summaryText"></span>
                    <span class="loading-label" x-cloak x-show="isLoading"><i></i><i></i><i></i> 正在载入</span>
                </div>
                <div class="song-table" role="table" aria-label="曲目列表">
                    <div class="song-row song-head" role="row">
                        <span></span><span>标题</span><span>艺术家</span><span>专辑</span><span>格式</span><span>大小</span><span>时长</span>
                    </div>
                    <template x-for="(song,index) in songs" :key="song.id">
                        <div class="song-row" role="row" tabindex="0"
                             :data-song-id="song.id"
                             :class="{'active':currentSong?.id===song.id,'selected':selectedSong?.id===song.id,'locate-pulse':locatedSongId===song.id}"
                             @pointerenter="prewarmSong(song)" @focusin="prewarmSong(song)"
                            @click="selectedSong=song;prewarmSong(song)" @dblclick="playSong(song)" @keydown.enter="playSong(song)">
                            <button class="row-play" @click.stop="playSong(song)" :aria-label="`播放 ${song.title}`">
                                <span class="row-play-state"
                                      :class="{'is-playing':currentSong?.id===song.id && isPlaying}"
                                      aria-hidden="true"><i></i><i></i><i></i></span>
                            </button>
                            <span class="title-cell"><strong x-text="song.title"></strong><small x-text="song.album?.title || song.artist?.name || '未知来源'"></small></span>
                            <span x-text="song.artist?.name || '未知艺术家'"></span>
                            <span class="album-cell" x-text="song.album?.title || '—'"></span>
                            <span><em class="format-badge" x-text="song.fileFormat" :style="`--badge:${formatColor(song.fileFormat)}`"></em></span>
                            <span class="size-cell" x-text="formatBytes(song.fileSize)"></span>
                            <span class="duration-cell" x-text="formatDuration(song.duration)"></span>
                        </div>
                    </template>
                </div>
                <div class="empty-state" x-cloak x-show="!isLoading && songs.length===0">
                    <img src="/brand/orz-logo-mono.svg" alt=""><h2>没有找到曲目</h2><p>试试更换格式分类或搜索关键词。</p>
                    <button @click="resetFilters">查看全部曲目</button>
                </div>
                <button class="load-more" x-cloak x-show="hasMore && !isLoading" @click="loadMore">加载更多</button>
            </section>
        </main>
    </div>

    <div class="viz-panel" x-cloak x-show="currentSong && visualizerOpen">
        <div class="viz-toolbar">
            <button class="viz-mode-btn" @click="toggleVisualizerMode"
                    :aria-label="`切换可视化模式：${visualizerMode==='holographic'?'全息声场':'频谱'}`"
                    aria-keyshortcuts="Shift+V" title="切换声场类型 (Shift + V)"
                    x-text="visualizerMode==='holographic'?'全息':'频谱'"></button>
            <button class="viz-toggle" @click="toggleVisualizer"
                    aria-label="折叠可视化面板" aria-keyshortcuts="V" title="折叠 (V)">▼</button>
        </div>
        <canvas class="viz-canvas" role="presentation" aria-hidden="true"
                id="visualizerCanvas"></canvas>
    </div>

    <button class="viz-expand-btn" x-cloak x-show="currentSong && !visualizerOpen"
            @click="toggleVisualizer"
            aria-label="展开可视化面板" aria-keyshortcuts="V" title="全息声场 (V)">▸ 声场</button>

    <div class="scrim" x-cloak x-show="sidebarOpen || playlistOpen" x-transition.opacity @click="sidebarOpen=false;playlistOpen=false"></div>

    <aside class="queue-panel" :class="{'open':playlistOpen}" aria-label="播放队列">
        <div class="panel-head"><div><small>接下来播放</small><h2>播放队列</h2></div><button class="icon-btn" @click="playlistOpen=false" aria-label="关闭播放队列">✕</button></div>
        <div class="queue-list">
            <template x-for="(song,idx) in queue" :key="song.id">
                <div class="queue-item" :class="{'active':currentSong?.id===song.id}" @click="playSong(song)">
                    <span x-text="String(idx+1).padStart(2,'0')"></span><div><strong x-text="song.title"></strong><small x-text="song.artist?.name || song.fileFormat.toUpperCase()"></small></div>
                    <button @click.stop="removeFromQueue(idx)" :aria-label="`从队列移除 ${song.title}`">×</button>
                </div>
            </template>
            <div class="queue-empty" x-show="queue.length===0"><img src="/brand/orz-logo-mono.svg" alt=""><p>队列还是空的</p></div>
        </div>
        <div class="playlist-tools">
            <input type="text" x-model="newPlaylistName" placeholder="播放列表名称" @keydown.enter="saveAsPlaylist">
            <button @click="saveAsPlaylist" :disabled="!newPlaylistName.trim() || !queue.length">保存当前队列</button>
            <template x-for="pl in playlists" :key="pl.id"><div class="saved-list"><button @click="loadPlaylist(pl.id)"><span x-text="pl.name"></span><small x-text="`${pl.songCount || 0} 首`"></small></button><button @click="deletePlaylist(pl.id)" aria-label="删除播放列表">×</button></div></template>
        </div>
    </aside>

    <footer class="player-dock" :class="{'idle':!currentSong}">
        <div class="seek-wrap" @pointermove="previewSeek" @pointerleave="seekPreview=null" @click="seek" id="progressContainer">
            <div class="seek-track"><div class="seek-buffer"></div><div class="seek-fill" :style="`width:${progressPercent}%`"></div><span class="seek-thumb" :style="`left:${progressPercent}%`"></span></div>
            <span class="seek-preview" x-cloak x-show="seekPreview!==null" :style="`left:${seekPreview?.left || 0}px`" x-text="formatTime(seekPreview?.time)"></span>
        </div>
        <div class="dock-grid">
            <div class="now-playing">
                <button class="track-art" @click="locateCurrentSong"
                        :disabled="!currentSong || locating" title="定位当前曲目 (L)"
                        aria-label="定位当前曲目" aria-keyshortcuts="L">
                    <img src="/brand/orz-logo.svg" alt="" :class="{'pulse':isLoadingTrack || locating}">
                </button>
                <div class="now-playing-body">
                    <div class="now-playing-copy">
                        <strong x-text="currentSong?.title || '选择一首曲目开始播放'"></strong>
                        <span x-text="nowPlayingMeta"></span>
                    </div>
                </div>
            </div>
            <div class="transport">
                <button @click="prev" :disabled="!canPrev" title="上一首 (P)" aria-label="上一首" aria-keyshortcuts="P">
                    <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor" aria-hidden="true">
                        <path d="M6.5 5a1 1 0 0 1 1 1v5.05l9.86-6.13A1.08 1.08 0 0 1 19 5.84v12.32a1.08 1.08 0 0 1-1.64.92L7.5 12.95V18a1 1 0 1 1-2 0V6a1 1 0 0 1 1-1Z"></path>
                    </svg>
                </button>
                <button class="main-play" @click="togglePlay" :disabled="!currentSong" :title="isPlaying?'暂停 (空格)':'播放 (空格)'" :aria-label="isPlaying?'暂停':'播放'" aria-keyshortcuts="Space">
                    <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor" aria-hidden="true">
                        <path :d="isPlaying
                            ? 'M7 5.5A1.5 1.5 0 0 1 8.5 4h1A1.5 1.5 0 0 1 11 5.5v13A1.5 1.5 0 0 1 9.5 20h-1A1.5 1.5 0 0 1 7 18.5v-13Zm6 0A1.5 1.5 0 0 1 14.5 4h1A1.5 1.5 0 0 1 17 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-1a1.5 1.5 0 0 1-1.5-1.5v-13Z'
                            : 'M8 5.85a1.18 1.18 0 0 1 1.84-.98l9.05 6.15a1.18 1.18 0 0 1 0 1.96l-9.05 6.15A1.18 1.18 0 0 1 8 18.15V5.85Z'"></path>
                    </svg>
                </button>
                <button @click="next" :disabled="!canNext" title="下一首 (N)" aria-label="下一首" aria-keyshortcuts="N">
                    <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor" aria-hidden="true">
                        <path d="M17.5 5a1 1 0 0 0-1 1v5.05L6.64 4.92A1.08 1.08 0 0 0 5 5.84v12.32a1.08 1.08 0 0 0 1.64.92l9.86-6.13V18a1 1 0 1 0 2 0V6a1 1 0 0 0-1-1Z"></path>
                    </svg>
                </button>
                <span class="dock-time" x-text="timeDisplay"></span>
            </div>
            <div class="volume-control">
                <button @click="toggleMute" title="静音 (M)" aria-label="静音或恢复音量" aria-keyshortcuts="M">
                    <svg x-show="volume>0" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M11 5 6 9H3v6h3l5 4V5Z"></path>
                        <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
                        <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
                    </svg>
                    <svg x-show="volume===0" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M11 5 6 9H3v6h3l5 4V5Z"></path>
                        <path d="m16 9 5 5"></path>
                        <path d="m21 9-5 5"></path>
                    </svg>
                </button>
                <input type="range" min="0" max="1" step="0.01" x-model.number="volume" @input="setVolume" aria-label="音量">
                <span x-text="`${Math.round(volume*100)}%`"></span>
            </div>
        </div>
    </footer>

    <div class="toast-stack" aria-live="assertive"><template x-for="toast in toasts" :key="toast.id"><div class="toast" :class="toast.type" x-transition><span x-text="toast.message"></span><button @click="dismissToast(toast.id)">×</button></div></template></div>
    <div class="modal" id="directory-import-panel" x-cloak x-show="importOpen" x-transition.opacity @click.self="importOpen=false" @keydown.escape.window="importOpen=false" role="dialog" aria-modal="true" aria-labelledby="directory-import-title">
        <section class="import-panel">
            <div class="panel-head"><div><small>管理员工具</small><h2 id="directory-import-title">导入本地目录</h2></div><button class="icon-btn" @click="importOpen=false" aria-label="关闭目录导入">✕</button></div>
            <p class="import-intro">浏览器仅在你选择后读取文件；管理令牌仅保留到本次浏览器会话。按 <kbd class="import-hint-key">I</kbd> 可随时打开本面板。</p>
            <label class="token-field">管理令牌
                <input type="password" autocomplete="off" x-model="adminToken" @input="saveAdminToken" placeholder="ADMIN_API_TOKEN" aria-label="管理令牌">
            </label>
            <div class="import-actions">
                <input id="directoryPicker" class="visually-hidden" type="file" webkitdirectory directory multiple :disabled="importRunning" @change="selectImportFiles($event.target.files);$event.target.value=''" aria-label="选择本地音乐目录" x-ref="directoryPicker">
                <input id="filePicker" class="visually-hidden" type="file" multiple :disabled="importRunning" @change="selectImportFiles($event.target.files);$event.target.value=''" aria-label="选择本地音乐文件" x-ref="filePicker">
                <button type="button" class="import-picker-button" @click="$refs.directoryPicker.click()" :disabled="importRunning" title="选择本地音乐目录">选择目录</button>
                <button type="button" class="import-picker-button" @click="$refs.filePicker.click()" :disabled="importRunning" title="选择本地音乐文件">选择文件</button>
                <button type="button" class="quiet" @click="clearAdminToken" :disabled="importRunning || !adminToken">清除令牌</button>
            </div>
            <div class="import-summary" x-show="importItems.length" x-cloak aria-live="polite">
                <strong x-text="`${importProgress}%`"></strong>
                <span x-text="`共 ${importItems.length} 个 · 新增 ${importCreated} · 重复 ${importDuplicates} · 失败 ${importFailed}`"></span>
                <div class="import-progress"><i :style="`width:${importProgress}%`"></i></div>
                <p x-show="importRunning" class="import-bytes"><span x-text="`已上传 ${formatBytes(importLoadedBytes)} / ${formatBytes(importTotalBytes)}`"></span></p>
                <p x-show="importRunning">正在处理：<span x-text="currentUploadLabel()" class="current-import-file"></span></p>
            </div>
            <div class="import-list" x-show="importItems.length" x-cloak>
                <template x-for="item in importItems" :key="item.path">
                    <div class="import-item" :class="item.status"><span x-text="item.path"></span><small x-text="item.status==='uploading'?`上传中 ${itemUploadPercent(item)}%`:item.status==='created'?'已新增':item.status==='duplicate'?'已存在':item.status==='queued'?`等待中 · ${formatBytes(item.file?.size)}`:item.error"></small><i class="import-item-bar" x-show="item.status==='uploading'" :style="`width:${itemUploadPercent(item)}%`"></i></div>
                </template>
            </div>
            <button class="retry-import" x-show="importFailed && !importRunning" x-cloak @click="retryImportFailures" :disabled="!importItems.some(item=>item.status==='failed' && item.retryable)">重试失败项</button>
        </section>
    </div>
    <div class="modal" x-cloak x-show="shortcutOpen" x-transition.opacity @click.self="shortcutOpen=false" @keydown.escape.window="shortcutOpen=false">
        <section><div class="panel-head"><div><small>轻松操控</small><h2>键盘快捷键</h2></div><button class="icon-btn" @click="shortcutOpen=false">✕</button></div>
            <div class="shortcut-grid"><template x-for="item in shortcuts" :key="item.key"><div><kbd x-text="item.key"></kbd><span x-text="item.label"></span></div></template></div>
        </section>
    </div>
</body>
</html>
